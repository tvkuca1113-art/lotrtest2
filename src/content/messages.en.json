  "ui.001": "Save unavailable · export from Settings",
  "ui.002": "<main class=\"title-screen\"><div class=\"title-shade\"></div><div class=\"title-content\"><div class=\"eyebrow\">AN ORIGINAL NORTHERN VALLEY STORY</div><div class=\"crest\">{0}</div><h1>THE LAST<br><span>HEARTH</span></h1><div class=\"title-rule\"><span></span>RINGS OF THE NORTH<span></span></div><p class=\"promise\">A broken sword. A valley in shadow.<br>A hearth worth fighting for.</p><div class=\"title-actions\">{1}<button class=\"{2}\" data-action=\"new\">{3}<span>↗</span></button><div class=\"row\"><button data-action=\"title-settings\">Settings</button><button data-action=\"credits\">Credits</button></div></div><p class=\"version\">VERSION 0.1 <i></i> SINGLE PLAYER <i></i> LOCAL SAVE</p></div><div class=\"title-caption\"><span>THE HOME YOU HAVEN’T BUILT. YET.</span><p>Every light begins with someone who stays.</p></div><footer>{4} · Original art & audio</footer></main><div id=\"modal-host\"></div><div id=\"toast\" role=\"status\"></div>",

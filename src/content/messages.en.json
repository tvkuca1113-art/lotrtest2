  "ui.089": "YOUR JOURNEY",
  "ui.090": "<div class=\"settings-grid\"><div><label>Difficulty<select data-setting=\"difficulty\">{0}</select></label>{1}</div><div>{2}</div></div><p class=\"muted\">Desktop: WASD / arrows, pointer aim, click to strike, Space to dodge. Keyboard-only attacks use J and K. All controls can be remapped during play. Touch controls appear on mobile.</p><button class=\"primary\" data-action=\"title-close\">Return to title</button>",
  "ui.091": "The traveller’s exchange",
  "ui.092": "TRADE · GUARANTEED STOCK · NO RANDOM PURCHASES",
  "ui.093": "<div class=\"split\"><div><h3>For sale</h3>{0}</div><div><h3>In your pack</h3>{1}<button data-action=\"salvage-all\" {2}>Salvage all unlocked, unequipped items</button><p class=\"muted\">Equipped and locked items are protected. A full pack sends new equipment to recoverable overflow storage.</p></div></div>",
  "ui.094": "<div class=\"item-row\"><div><b>{0}</b><small>{1} · {2} · Tier {3}</small></div><button data-action=\"buy:{4}\" {5}>{6} gold</button></div>",

  "ui.043": "<div class=\"chapter-tabs\">{0}</div><div class=\"campaign-layout\"><div><h3>{1}</h3><p class=\"muted\">{2}</p><div class=\"stage-list\">{3}</div><p class=\"chapter-story\">{4}</p></div><article class=\"departure-card\"><span class=\"eyebrow\">{5} · RECOMMENDED LEVEL {6}</span><h2>{7}</h2><p>{8}.</p><dl><dt>The enemy beyond the gate</dt><dd>{9}<br><span class=\"muted\">{10}</span></dd><dt>Season on departure</dt><dd>{11} · day {12} of 4<br><span class=\"muted\">{13}</span></dd><dt>{14}</dt><dd>{15}{16}</dd><dt>Equipped rings</dt><dd>{17}</dd><dt>Installed at home</dt><dd>{18}</dd></dl><button class=\"primary\" data-action=\"depart:{19}\" {20}>{21}</button>{22}</article></div>",
